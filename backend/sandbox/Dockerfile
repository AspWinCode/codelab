# Образ для изолированного запуска решений учеников (JDG-002/003, SEC-004).
# Собрать: docker build -t codelab-runner:python3.12 backend/sandbox
#
# Контейнер запускается с --network none, --read-only, --cap-drop ALL и
# --user 65534:65534 (см. app/services/runner_docker.py) — сам образ не
# должен требовать root или запись за пределы /tmp.
FROM python:3.12-slim

# Версии интерпретатора/библиотек фиксируются образом (ADM-002): пересборка
# с другим тегом = новое неизменяемое окружение исполнения, старое не трогаем.
# NumPy/Pandas и разрешённые библиотеки (Q-05, TASK-004) добавляются здесь
# отдельным окружением, а не в этот базовый python3-only образ.

WORKDIR /sandbox

# Никаких дополнительных пакетов ОС: меньше поверхность атаки в изоляции,
# где и так нет сети и записи на диск.
