# Прод .env для docker-compose.yml — реальный файл лежит на хосте
# (/root/codelab/.env), в репозиторий не коммитится.
POSTGRES_PASSWORD=
SECRET_KEY=
# Тот же секрет, что в learning-portal-main/.env — им подписаны SSO-токены
# и HMAC серверных запросов между системами.
SSO_KODEX_SHARED_SECRET=
FRONTEND_BASE_URL=https://codelab.tirskix.space
